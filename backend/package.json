{
  "name": "@glow/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy && npm run db:seed && node dist/src/server.js",
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "owner:create": "tsx prisma/create-owner.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "prisma": "7.10.1",
    "swagger-ui-express": "5.0.1",
    "tsx": "4.20.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/pg": "8.16.0",
    "@types/swagger-ui-express": "4.1.8",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "supertest": "7.1.3",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  }
}
