{
  "name": "glow-cosmetics",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- concurrently -k -n backend,frontend -c green,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "dotenv -e .env -- npm --workspace @glow/backend run dev",
    "dev:frontend": "dotenv -e .env -- npm --workspace @glow/frontend run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "dotenv -e .env -- npm --workspace @glow/backend run db:generate",
    "db:migrate": "dotenv -e .env -- npm --workspace @glow/backend run db:migrate --",
    "db:seed": "dotenv -e .env -- npm --workspace @glow/backend run db:seed",
    "db:deploy": "dotenv -e .env -- npm --workspace @glow/backend run db:deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "postcss": "8.5.31"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "dotenv-cli": "8.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "5.7.3"
  }
}
